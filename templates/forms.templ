package templates

import (
	"context"
	"encoding/json"
	"fmt"
	"net/url"
	"sort"
	"strings"

	"github.com/koalastuff/koalabye/internal/db"
)

templ CampaignForm(instanceName string, user db.User, campaign db.Campaign, branding db.CampaignBranding, fields []db.FormField, canEdit bool, errorKey string) {
	@Layout(tr(ctx, "form.title"), instanceName, &user) {
		@CampaignNav(campaign)
		<section class="page-heading">
			<div><div class="eyebrow">{ campaign.Name }</div><h1>{ tr(ctx, "form.title") }</h1><p class="muted">{ tr(ctx, "form.description") }</p></div>
		</section>
		if !canEdit {
			<div class="notice">{ tr(ctx, "form.read_only") }</div>
		}
		if errorKey != "" {
			<div class="alert" role="alert">{ tr(ctx, errorKey) }</div>
		}
		<section class="grid two">
			<div>
				if canEdit && len(fields) > 1 {
					<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/reorder") } data-reorder-form class="mb-24">
						<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
						<div data-order-inputs></div>
						<button type="submit" class="secondary" data-reorder-save hidden>{ tr(ctx, "common.save") }</button>
					</form>
				}
				<div data-field-list>
					for index, field := range fields {
						<article class="panel form-field-card" draggable="true" data-field-id={ field.PublicID }>
							<div class="field-heading">
								<div><span class="badge quiet">{ tr(ctx, "form.type." + field.FieldType) }</span><h2>{ field.Label }</h2></div>
								if canEdit {
									<a href={ templ.SafeURL(campaignPath(campaign) + "/form/fields/" + field.PublicID + "/edit") }>{ tr(ctx, "common.edit") }</a>
								}
							</div>
							if field.HelpText.Valid {
								<p>{ field.HelpText.String }</p>
							}
							if field.Required {
								<span class="badge">{ tr(ctx, "form.required") }</span>
							} else {
								<span class="badge quiet">{ tr(ctx, "form.optional") }</span>
							}
							if canEdit {
								<div class="actions compact">
									@fieldAction(campaign, field, "up", index == 0)
									@fieldAction(campaign, field, "down", index == len(fields)-1)
									<form class="inline-form" method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/fields/" + field.PublicID + "/archive") }><input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/><button class="link-button danger" type="submit" data-tooltip={ tr(ctx, "tooltip.btn.remove") }>{ tr(ctx, "common.remove") }</button></form>
								</div>
							}
						</article>
					}
				</div>
				if len(fields) == 0 {
					<div class="notice">{ tr(ctx, "form.empty") }</div>
				}
			</div>
			<div>
				if canEdit {
					<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/presets") } class="panel form-stack mb-24">
						<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
						<h2>{ tr(ctx, "form.preset.load") }</h2>
						<div class="flex-gap-12">
							<select name="preset_id" class="flex-1">
								<option value="uninstall">{ tr(ctx, "form.preset.uninstall") }</option>
								<option value="feedback">{ tr(ctx, "form.preset.feedback") }</option>
								<option value="bug">{ tr(ctx, "form.preset.bug") }</option>
							</select>
							<button type="submit" class="secondary">{ tr(ctx, "form.preset.load") }</button>
						</div>
					</form>
					<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/fields") } class="panel form-stack">
						<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
						<h2>{ tr(ctx, "form.add") }</h2>
						<label>
							<div class="field-header"><span>{ tr(ctx, "form.field_type") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_type") } data-tooltip={ tr(ctx, "tooltip.field.form_type") }>i</span></div>
							<select name="field_type">
								@fieldTypeOptions("")
							</select>
						</label>
						<label><div class="field-header"><span>{ tr(ctx, "form.label") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_label") } data-tooltip={ tr(ctx, "tooltip.field.form_label") }>i</span></div><input name="label" maxlength="300" required/></label>
						<label><div class="field-header"><span>{ tr(ctx, "form.help_text") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_help") } data-tooltip={ tr(ctx, "tooltip.field.form_help") }>i</span></div><textarea name="help_text" maxlength="1000"></textarea></label>
						<label class="check conditional-required"><input type="checkbox" name="required"/>{ tr(ctx, "form.required") }</label>
						<label class="conditional-body"><div class="field-header"><span>{ tr(ctx, "form.text_block.body") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_body") } data-tooltip={ tr(ctx, "tooltip.field.form_body") }>i</span></div><textarea name="body" maxlength="5000"></textarea></label>
						<label class="conditional-max-length"><div class="field-header"><span>{ tr(ctx, "form.textarea.max_length") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_max") } data-tooltip={ tr(ctx, "tooltip.field.form_max") }>i</span></div><input type="number" name="max_length" value="1000" min="1" max="5000"/></label>
						<button type="submit" data-tooltip={ tr(ctx, "tooltip.btn.add") }>{ tr(ctx, "form.add") }</button>
					</form>
				}
				<section class="panel public-card p-0 overflow-hidden">
					<h2 class="p-16-24-0">{ tr(ctx, "form.preview") }</h2>
					<div id="preview-body" class={ bodyClass(&branding) + " preview-body-container-static" }>
						if len(fields) == 0 {
							<p>{ tr(ctx, "public.form.placeholder") }</p>
						} else {
							<div class="public-main preview-main-scaled">
								<section class="public-hero pt-20">
									<div class="eyebrow">{ campaign.Name }</div>
									<h1>{ nullableOr(branding.PublicHeading, tr(ctx, "public.heading")) }</h1>
									<p class="lede">{ nullableOr(branding.PublicIntro, tr(ctx, "public.intro")) }</p>
								</section>
								<form class="public-form public-card panel m-0">
									<h2>{ tr(ctx, "public.form.title") }</h2>
									<p>{ tr(ctx, "public.form.optional") }</p>
									@PublicFields(fields, false)
									<button class="primary mt-20 opacity-80" disabled>{ tr(ctx, "public.form.submit") }</button>
								</form>
								<details class="panel public-card" open>
									<summary class="font-bold-750"><h2 class="inline-heading">{ tr(ctx, "public.privacy.title") }</h2></summary>
									<p>{ tr(ctx, "public.privacy.text") }</p>
									<p class="muted">{ tr(ctx, "public.privacy.free_text") }</p>
								</details>
							</div>
						}
					</div>
				</section>
			</div>
		</section>
	}
}

templ CampaignFormFieldEdit(instanceName string, user db.User, campaign db.Campaign, field db.FormField, canEdit bool, errorKey string) {
	@Layout(tr(ctx, "form.edit"), instanceName, &user) {
		@CampaignNav(campaign)
		<section class="page-heading"><div><div class="eyebrow">{ tr(ctx, "form.type." + field.FieldType) }</div><h1>{ tr(ctx, "form.edit") }</h1></div></section>
		if !canEdit {
			<div class="notice">{ tr(ctx, "form.read_only") }</div>
		}
		if errorKey != "" {
			<div class="alert" role="alert">{ tr(ctx, errorKey) }</div>
		}
		<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/fields/" + field.PublicID) } class="panel form-stack">
			<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
			<label><div class="field-header"><span>{ tr(ctx, "form.label") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_label") } data-tooltip={ tr(ctx, "tooltip.field.form_label") }>i</span></div><input name="label" value={ field.Label } maxlength="300" required disabled?={ !canEdit }/></label>
			<label><div class="field-header"><span>{ tr(ctx, "form.help_text") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_help") } data-tooltip={ tr(ctx, "tooltip.field.form_help") }>i</span></div><textarea name="help_text" maxlength="1000" disabled?={ !canEdit }>{ field.HelpText.String }</textarea></label>
			if field.FieldType != "text_block" {
				<label class="check"><input type="checkbox" name="required" checked?={ field.Required } disabled?={ !canEdit }/>{ tr(ctx, "form.required") }</label>
			}
			if field.FieldType == "text_block" {
				<label><div class="field-header"><span>{ tr(ctx, "form.text_block.body") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_body") } data-tooltip={ tr(ctx, "tooltip.field.form_body") }>i</span></div><textarea name="body" maxlength="5000" disabled?={ !canEdit }>{ field.Config().Body }</textarea></label>
			}
			if field.FieldType == "textarea" {
				<label><div class="field-header"><span>{ tr(ctx, "form.textarea.max_length") }</span><span class="info-icon" tabindex="0" role="button" aria-label={ tr(ctx, "tooltip.field.form_max") } data-tooltip={ tr(ctx, "tooltip.field.form_max") }>i</span></div><input type="number" name="max_length" value={ fmt.Sprint(field.Config().MaxLength) } min="1" max="5000" disabled?={ !canEdit }/></label>
			}
			if field.FieldType == "checkbox_group" || field.FieldType == "radio_group" {
				<h2>{ tr(ctx, "form.options") }</h2>
				for _, option := range field.Options {
					if !option.ArchivedAt.Valid {
						<label>{ tr(ctx, "form.option.label") }<input name={ "option_" + option.PublicID } value={ option.Label } maxlength="200" disabled?={ !canEdit }/></label>
					}
				}
			}
			if canEdit {
				<button type="submit" data-tooltip={ tr(ctx, "tooltip.btn.save") }>{ tr(ctx, "common.save") }</button>
			}
		</form>
		if canEdit && (field.FieldType == "checkbox_group" || field.FieldType == "radio_group") {
			<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/fields/" + field.PublicID + "/options") } class="panel form-stack">
				<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
				<h2>{ tr(ctx, "form.option.add") }</h2>
				<label>{ tr(ctx, "form.option.label") }<input name="label" maxlength="200" required/></label>
				<label>{ tr(ctx, "form.option.value") }<input name="value" maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" title={ tr(ctx, "tooltip.field.slug_pattern") } required/></label>
				<button type="submit" data-tooltip={ tr(ctx, "tooltip.btn.add") }>{ tr(ctx, "form.option.add") }</button>
			</form>
			<section class="panel">
				<h2>{ tr(ctx, "form.options") }</h2>
				for _, option := range field.Options {
					if !option.ArchivedAt.Valid {
						<div class="field-heading">
							<span>{ option.Label } <code>{ option.Value }</code></span>
							<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/fields/" + field.PublicID + "/options/" + option.PublicID + "/archive") } class="inline-form"><input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/><button class="link-button danger" type="submit" data-tooltip={ tr(ctx, "tooltip.btn.remove") }>{ tr(ctx, "common.remove") }</button></form>
						</div>
					}
				}
			</section>
		}
	}
}

templ fieldAction(campaign db.Campaign, field db.FormField, direction string, disabled bool) {
	<form class="inline-form" method="post" action={ templ.SafeURL(campaignPath(campaign) + "/form/fields/" + field.PublicID + "/move") }>
		<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/><input type="hidden" name="direction" value={ direction }/>
		<button class="link-button" type="submit" disabled?={ disabled } data-tooltip={ tr(ctx, "tooltip.btn.move_"+direction) }>{ tr(ctx, "form.move." + direction) }</button>
	</form>
}

templ fieldTypeOptions(selected string) {
	for _, fieldType := range []string{"textarea", "rating_1_5", "radio_group", "checkbox_group", "text_block"} {
		<option value={ fieldType } selected?={ selected == fieldType }>{ tr(ctx, "form.type." + fieldType) }</option>
	}
}

templ PublicFields(fields []db.FormField, enabled bool) {
	for _, field := range fields {
		<fieldset class="public-field">
			if field.FieldType == "text_block" {
				<legend>{ field.Label }</legend>
				<p>{ field.Config().Body }</p>
			} else {
				<legend>
					{ field.Label }
					if field.Required {
						<span aria-hidden="true">*</span>
					}
				</legend>
				if field.HelpText.Valid {
					<p class="muted" id={ helpID(field) }>{ field.HelpText.String }</p>
				}
				switch field.FieldType {
					case "textarea":
						<textarea name={ "field_" + field.PublicID } maxlength={ fmt.Sprint(field.Config().MaxLength) } required?={ enabled && field.Required } disabled?={ !enabled } { fieldAttrs(field)... }></textarea>
					case "rating_1_5":
						<div class="choice-row">
							for rating := 1; rating <= 5; rating++ {
								<label><input type="radio" name={ "field_" + field.PublicID } value={ fmt.Sprint(rating) } required?={ enabled && field.Required } disabled?={ !enabled } { fieldAttrs(field)... }/> { fmt.Sprint(rating) }</label>
							}
						</div>
					case "radio_group":
						for _, option := range field.Options {
							if !option.ArchivedAt.Valid {
								<label class="choice"><input type="radio" name={ "field_" + field.PublicID } value={ option.Value } required?={ enabled && field.Required } disabled?={ !enabled } { fieldAttrs(field)... }/> { option.Label }</label>
							}
						}
					case "checkbox_group":
						for _, option := range field.Options {
							if !option.ArchivedAt.Valid {
								<label class="choice"><input type="checkbox" name={ "field_" + field.PublicID } value={ option.Value } disabled?={ !enabled } { fieldAttrs(field)... }/> { option.Label }</label>
							}
						}
				}
			}
		</fieldset>
	}
}

templ CampaignResponses(instanceName string, user db.User, campaign db.Campaign, settings db.CampaignSettings, data ResponsesPageData) {
	{{ page := data.Page }}
	{{ filter := data.Filter }}
	{{ canEdit := data.CanEdit }}
	@Layout(tr(ctx, "responses.title"), instanceName, &user) {
		@CampaignNav(campaign)
		<section class="page-heading">
			<div><div class="eyebrow">{ campaign.Name }</div><h1>{ tr(ctx, "responses.title") }</h1></div>
			<div class="heading-actions">
				<a class="button secondary" href={ templ.SafeURL(responsesExportURL(campaign, filter, "csv")) }>{ tr(ctx, "responses.export_csv") }</a>
				<a class="button secondary" href={ templ.SafeURL(responsesExportURL(campaign, filter, "json")) }>{ tr(ctx, "responses.export_json") }</a>
				if settings.DevFeedbackIssueURL.Valid {
					<a class="button secondary" href={ templ.SafeURL(settings.DevFeedbackIssueURL.String) } target="_blank" rel="noopener noreferrer">{ tr(ctx, "responses.github_issue.open") }</a>
				}
			</div>
		</section>
		if filter.IsFiltered() {
			<p class="muted">{ tr(ctx, "responses.export_filtered_hint") }</p>
		}
		<nav class="response-chips" aria-label={ tr(ctx, "responses.chips_aria") }>
			@responseChip(campaign, filter, db.ResponseFilter{}, "responses.chip.all", page.Counts.Total)
			@responseChip(campaign, filter, db.ResponseFilter{Read: "unread_me"}, "responses.chip.unread_me", page.Counts.UnreadMe)
			@responseChip(campaign, filter, db.ResponseFilter{Read: "unread"}, "responses.chip.unread", page.Counts.Unread)
			@responseChip(campaign, filter, db.ResponseFilter{Assignee: "me", Status: "open"}, "responses.chip.assigned_me", page.Counts.AssignedMe)
			@responseChip(campaign, filter, db.ResponseFilter{Content: "text"}, "responses.chip.text", page.Counts.WithText)
			@responseChip(campaign, filter, db.ResponseFilter{Starred: true}, "responses.chip.starred", page.Counts.Starred)
			@responseChip(campaign, filter, db.ResponseFilter{Status: "actionable"}, "responses.chip.actionable", page.Counts.Actionable)
		</nav>
		if len(data.Views) > 0 {
			<section class="response-views" aria-label={ tr(ctx, "responses.views.title") }>
				<span class="muted">{ tr(ctx, "responses.views.title") }</span>
				for _, view := range data.Views {
					<span class="view-item">
						<a class="chip" href={ templ.SafeURL(responsesPageURL(campaign, view.Filter, 1)) } { responseChipAttrs(filter, view.Filter)... }>
							{ view.Name }
							if view.Shared && !view.IsMine {
								<span class="muted">· { view.OwnerName }</span>
							} else if view.Shared {
								<span class="muted">· { tr(ctx, "responses.views.shared") }</span>
							}
						</a>
						if view.IsMine || data.IsOwner {
							<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/views/" + view.PublicID + "/delete") } class="inline-form">
								<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
								<button type="submit" class="link-button" aria-label={ tr(ctx, "responses.views.delete", view.Name) } title={ tr(ctx, "responses.views.delete", view.Name) }>×</button>
							</form>
						}
					</span>
				}
			</section>
		}
		<section class="panel">
			<form method="get" action={ templ.SafeURL(campaignPath(campaign) + "/responses") } class="response-filter">
				<label class="filter-search"><span class="muted">{ tr(ctx, "responses.filter.search") }</span><input type="search" name="q" value={ filter.Query } maxlength="500" autocomplete="off" data-shortcut-search/></label>
				<label>
					<span class="muted">{ tr(ctx, "responses.status") }</span>
					<select name="status">
						<option value="" selected?={ filter.Status == "" }>{ tr(ctx, "responses.filter.any") }</option>
						<option value="open" selected?={ filter.Status == "open" }>{ tr(ctx, "responses.status.open") }</option>
						for _, status := range []string{"new", "reviewed", "actionable", "closed"} {
							<option value={ status } selected?={ filter.Status == status }>{ tr(ctx, "responses.status." + status) }</option>
						}
					</select>
				</label>
				<label>
					<span class="muted">{ tr(ctx, "responses.read_state") }</span>
					<select name="read">
						<option value="" selected?={ filter.Read == "" }>{ tr(ctx, "responses.filter.any") }</option>
						for _, value := range []string{"unread", "unread_me", "team", "mine"} {
							<option value={ value } selected?={ filter.Read == value }>{ tr(ctx, "responses.filter.read." + value) }</option>
						}
					</select>
				</label>
				<label>
					<span class="muted">{ tr(ctx, "responses.content") }</span>
					<select name="content">
						<option value="" selected?={ filter.Content == "" }>{ tr(ctx, "responses.filter.any") }</option>
						<option value="text" selected?={ filter.Content == "text" }>{ tr(ctx, "responses.content.text") }</option>
						<option value="choices" selected?={ filter.Content == "choices" }>{ tr(ctx, "responses.content.choices") }</option>
					</select>
				</label>
				<label>
					<span class="muted">{ tr(ctx, "responses.assignee") }</span>
					<select name="assignee">
						<option value="" selected?={ filter.Assignee == "" }>{ tr(ctx, "responses.filter.any") }</option>
						<option value="me" selected?={ filter.Assignee == "me" }>{ tr(ctx, "responses.assignee.me") }</option>
						<option value="none" selected?={ filter.Assignee == "none" }>{ tr(ctx, "responses.assignee.none") }</option>
						for _, member := range data.Members {
							<option value={ member.PublicID } selected?={ filter.Assignee == member.PublicID }>{ member.Name }</option>
						}
					</select>
				</label>
				<label>
					<span class="muted">{ tr(ctx, "responses.tag") }</span>
					<select name="tag">
						<option value="" selected?={ filter.Tag == "" }>{ tr(ctx, "responses.filter.any") }</option>
						for _, tag := range data.Tags {
							<option value={ tag.Name } selected?={ strings.EqualFold(filter.Tag, tag.Name) }>{ tag.Name } ({ fmt.Sprint(tag.Count) })</option>
						}
					</select>
				</label>
				<label><span class="muted">{ tr(ctx, "responses.filter.from") }</span><input type="date" name="from" value={ filter.From }/></label>
				<label><span class="muted">{ tr(ctx, "responses.filter.to") }</span><input type="date" name="to" value={ filter.To }/></label>
				<label>
					<span class="muted">{ tr(ctx, "responses.filter.sort") }</span>
					<select name="sort">
						<option value="" selected?={ !filter.Oldest }>{ tr(ctx, "responses.filter.sort.newest") }</option>
						<option value="oldest" selected?={ filter.Oldest }>{ tr(ctx, "responses.filter.sort.oldest") }</option>
					</select>
				</label>
				<label class="filter-check"><input type="checkbox" name="starred" value="1" checked?={ filter.Starred }/> { tr(ctx, "responses.filter.starred_only") }</label>
				<div class="filter-actions">
					<button type="submit">{ tr(ctx, "responses.filter.apply") }</button>
					if filter.IsFiltered() || filter.Oldest {
						<a class="button secondary" href={ templ.SafeURL(campaignPath(campaign) + "/responses") }>{ tr(ctx, "responses.filter.reset") }</a>
					}
				</div>
			</form>
			if filter.IsFiltered() || filter.Oldest {
				<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/views") } class="save-view-form">
					<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
					for _, field := range responseFilterFields(filter) {
						<input type="hidden" name={ field[0] } value={ field[1] }/>
					}
					<label><span class="muted">{ tr(ctx, "responses.views.name") }</span><input type="text" name="name" maxlength="60" required/></label>
					if canEdit {
						<label class="filter-check"><input type="checkbox" name="shared"/> { tr(ctx, "responses.views.share") }</label>
					}
					<button type="submit" class="secondary">{ tr(ctx, "responses.views.save") }</button>
				</form>
			}
		</section>
		<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/bulk") } class="panel table-wrap" data-bulk-form data-shortcuts="list">
			<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
			for _, field := range responseFilterFields(filter) {
				<input type="hidden" name={ field[0] } value={ field[1] }/>
			}
			<p class="muted response-count">{ tr(ctx, "responses.matching", page.Matching) } · <button type="button" class="link-button" data-shortcut-help-toggle>{ tr(ctx, "responses.shortcuts.toggle") }</button></p>
			@shortcutHelp("list")
			if len(page.Submissions) > 0 {
				<div class="bulk-bar">
					<label class="filter-check"><input type="checkbox" data-select-all/> { tr(ctx, "responses.select_all") }</label>
					<select name="action" aria-label={ tr(ctx, "responses.bulk.action") }>
						<option value="read">{ tr(ctx, "responses.bulk.read") }</option>
						<option value="unread">{ tr(ctx, "responses.bulk.unread") }</option>
						if canEdit {
							<option value="star">{ tr(ctx, "responses.bulk.star") }</option>
							<option value="unstar">{ tr(ctx, "responses.bulk.unstar") }</option>
							for _, status := range []string{"new", "reviewed", "actionable", "closed"} {
								<option value={ "status_" + status }>{ tr(ctx, "responses.bulk.status", tr(ctx, "responses.status." + status)) }</option>
							}
							for _, member := range data.Members {
								<option value={ "assign:" + member.PublicID }>{ tr(ctx, "responses.bulk.assign", member.Name) }</option>
							}
							<option value="unassign">{ tr(ctx, "responses.bulk.unassign") }</option>
							<option value="tag_add">{ tr(ctx, "responses.bulk.tag_add") }</option>
							<option value="tag_remove">{ tr(ctx, "responses.bulk.tag_remove") }</option>
						}
					</select>
					if canEdit {
						<input type="text" name="tag" list="response-tag-options" maxlength="30" placeholder={ tr(ctx, "responses.bulk.tag_placeholder") } aria-label={ tr(ctx, "responses.bulk.tag_placeholder") }/>
						@tagDatalist(data.Tags)
					}
					if page.Matching > int64(len(page.Submissions)) {
						<label class="filter-check"><input type="checkbox" name="scope" value="filter"/> { tr(ctx, "responses.bulk.scope", page.Matching) }</label>
					}
					<button type="submit" class="secondary">{ tr(ctx, "responses.bulk.apply") }</button>
				</div>
			}
			<table>
				<caption>{ tr(ctx, "responses.table_caption", campaign.Name) }</caption>
				<thead><tr><th><span class="visually-hidden">{ tr(ctx, "responses.select") }</span></th><th><span class="visually-hidden">{ tr(ctx, "responses.starred") }</span></th><th>{ tr(ctx, "responses.submitted_at") }</th><th>{ tr(ctx, "responses.status") }</th><th>{ tr(ctx, "responses.read_state") }</th><th>{ tr(ctx, "responses.summary") }</th></tr></thead>
				<tbody>
					for _, submission := range page.Submissions {
						<tr class={ templ.KV("unread", !submission.ReadByMe) } data-row>
							<td><input type="checkbox" name="ids" value={ submission.PublicID } aria-label={ tr(ctx, "responses.select_row", submission.PublicID) }/></td>
							<td>
								if submission.Starred {
									<span class="star" title={ tr(ctx, "responses.starred") }>★<span class="visually-hidden">{ tr(ctx, "responses.starred") }</span></span>
								}
							</td>
							<td><a data-row-link href={ templ.SafeURL(campaignPath(campaign) + "/responses/" + submission.PublicID) }><time data-local-time datetime={ submission.SubmittedAt }>{ submission.SubmittedAt }</time></a></td>
							<td><span class={ "badge triage-" + submission.TriageStatus }>{ tr(ctx, "responses.status." + submission.TriageStatus) }</span></td>
							<td class="read-badges">
								if !submission.ReadByMe && submission.ReadByOthers == 0 {
									<span class="badge read-unread">{ tr(ctx, "responses.read.unread") }</span>
								}
								if submission.ReadByMe {
									<span class="badge read-mine">{ tr(ctx, "responses.read.mine") }</span>
								}
								if submission.ReadByOthers > 0 {
									<span class="badge read-team">{ tr(ctx, "responses.read.team", submission.ReadByOthers) }</span>
								}
							</td>
							<td class="response-preview">
								if submission.HasText {
									<span class="badge content-text">{ tr(ctx, "responses.content.text") }</span>
								} else {
									<span class="badge quiet">{ tr(ctx, "responses.content.choices") }</span>
								}
								if text := submissionTextPreview(submission); text != "" {
									<span class="preview-text">{ text }</span>
								}
								if choices := submissionChoicePreview(submission); choices != "" {
									<span class="preview-choices muted">{ choices }</span>
								}
								if submission.AssigneeName != "" || len(submission.Tags) > 0 || submission.NoteCount > 0 {
									<span class="preview-meta">
										if submission.AssigneeName != "" {
											<span class="badge assignee">→ { submission.AssigneeName }</span>
										}
										for _, tag := range submission.Tags {
											<span class="badge tag">#{ tag }</span>
										}
										if submission.NoteCount > 0 {
											<span class="badge quiet">{ tr(ctx, "responses.notes.count", submission.NoteCount) }</span>
										}
									</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(page.Submissions) == 0 {
				<div class="empty-state">
					if filter.IsFiltered() {
						<p>{ tr(ctx, "responses.empty.filtered") }</p>
					} else {
						<p>{ tr(ctx, "responses.empty") }</p>
					}
				</div>
			}
		</form>
		if page.PageCount > 1 {
			<nav class="pagination" aria-label={ tr(ctx, "responses.pagination.aria") }>
				if page.Page > 1 {
					<a class="button secondary" href={ templ.SafeURL(responsesPageURL(campaign, filter, page.Page-1)) }>{ tr(ctx, "responses.pagination.prev") }</a>
				}
				<span class="muted">{ tr(ctx, "responses.pagination.page", page.Page, page.PageCount) }</span>
				if page.Page < page.PageCount {
					<a class="button secondary" href={ templ.SafeURL(responsesPageURL(campaign, filter, page.Page+1)) }>{ tr(ctx, "responses.pagination.next") }</a>
				}
			</nav>
		}
		if canEdit {
			<details class="panel response-admin">
				<summary>{ tr(ctx, "responses.manage.title") }</summary>
				<h3>{ tr(ctx, "responses.manage.tags") }</h3>
				if len(data.Tags) == 0 {
					<p class="muted">{ tr(ctx, "responses.manage.tags_empty") }</p>
				} else {
					<ul class="tag-list">
						for _, tag := range data.Tags {
							<li class="view-item">
								<a class="chip" href={ templ.SafeURL(responsesPageURL(campaign, db.ResponseFilter{Tag: tag.Name}, 1)) }>#{ tag.Name } <strong>{ fmt.Sprint(tag.Count) }</strong></a>
								<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/tags/" + tag.PublicID + "/delete") } class="inline-form">
									<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
									<button type="submit" class="link-button" aria-label={ tr(ctx, "responses.manage.tag_delete", tag.Name) } title={ tr(ctx, "responses.manage.tag_delete", tag.Name) }>×</button>
								</form>
							</li>
						}
					</ul>
				}
				<h3>{ tr(ctx, "responses.autoclose.title") }</h3>
				<p class="muted">{ tr(ctx, "responses.autoclose.help") }</p>
				<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/auto-close") } class="response-status-form">
					<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
					<label>
						<span class="muted">{ tr(ctx, "responses.autoclose.after") }</span>
						<select name="days">
							<option value="0" selected?={ data.AutoCloseDays == 0 }>{ tr(ctx, "responses.autoclose.off") }</option>
							for _, days := range []int64{7, 14, 30, 60, 90, 180} {
								<option value={ fmt.Sprint(days) } selected?={ data.AutoCloseDays == days }>{ tr(ctx, "responses.autoclose.days", days) }</option>
							}
						</select>
					</label>
					<button type="submit" class="secondary">{ tr(ctx, "common.save") }</button>
				</form>
			</details>
		}
	}
}

templ responseChip(campaign db.Campaign, current, target db.ResponseFilter, labelKey string, count int64) {
	<a class="chip" href={ templ.SafeURL(responsesPageURL(campaign, target, 1)) } { responseChipAttrs(current, target)... }>
		{ tr(ctx, labelKey) } <strong>{ fmt.Sprint(count) }</strong>
	</a>
}

templ CampaignResponseDetail(instanceName string, user db.User, campaign db.Campaign, settings db.CampaignSettings, data ResponseDetailData) {
	{{ submission := data.Submission }}
	{{ neighbors := data.Neighbors }}
	@Layout(tr(ctx, "responses.detail"), instanceName, &user) {
		@CampaignNav(campaign)
		<div data-shortcuts="detail" data-list-url={ campaignPath(campaign) + "/responses" } data-newer-url={ responseNeighborURL(campaign, neighbors.NewerPublicID) } data-older-url={ responseNeighborURL(campaign, neighbors.OlderPublicID) } data-next-unread-url={ responseNeighborURL(campaign, neighbors.NextUnreadPublicID) }>
			<section class="page-heading">
				<div><div class="eyebrow"><time data-local-time datetime={ submission.SubmittedAt }>{ submission.SubmittedAt }</time></div><h1>{ tr(ctx, "responses.detail") }</h1></div>
				if responseIssueURL(settings, campaign, submission) != "" {
					<a class="button secondary" href={ templ.SafeURL(responseIssueURL(settings, campaign, submission)) } target="_blank" rel="noopener noreferrer">{ tr(ctx, "responses.github_issue.create") }</a>
				}
			</section>
			<nav class="response-pager" aria-label={ tr(ctx, "responses.pager_aria") }>
				<a href={ templ.SafeURL(campaignPath(campaign) + "/responses") }>{ tr(ctx, "responses.nav.back") }</a>
				if neighbors.NewerPublicID != "" {
					<a href={ templ.SafeURL(campaignPath(campaign) + "/responses/" + neighbors.NewerPublicID) }>{ tr(ctx, "responses.nav.newer") }</a>
				}
				if neighbors.OlderPublicID != "" {
					<a href={ templ.SafeURL(campaignPath(campaign) + "/responses/" + neighbors.OlderPublicID) }>{ tr(ctx, "responses.nav.older") }</a>
				}
				if neighbors.NextUnreadPublicID != "" {
					<a href={ templ.SafeURL(campaignPath(campaign) + "/responses/" + neighbors.NextUnreadPublicID) }>{ tr(ctx, "responses.nav.next_unread") }</a>
				}
				<button type="button" class="link-button" data-shortcut-help-toggle>{ tr(ctx, "responses.shortcuts.toggle") }</button>
			</nav>
			@shortcutHelp("detail")
			<div class="notice">{ tr(ctx, "responses.privacy") }</div>
			<section class="panel response-meta">
				<div><span class="muted">{ tr(ctx, "responses.status") }</span><strong>{ tr(ctx, "responses.status." + submission.TriageStatus) }</strong></div>
				<div><span class="muted">{ tr(ctx, "responses.visit") }</span><strong>{ nullable(submission.VisitPublicID) }</strong></div>
				<div><span class="muted">{ tr(ctx, "responses.token") }</span><strong>{ translatedBoolean(ctx, fmt.Sprint(submission.HasInstallTokenHash)) }</strong></div>
				<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/" + submission.PublicID + "/triage") } class="response-status-form">
					<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
					<label>
						<span class="muted">{ tr(ctx, "responses.status.change") }</span>
						<select name="triage_status">
							for _, status := range []string{"new", "reviewed", "actionable", "closed"} {
								<option value={ status } selected?={ submission.TriageStatus == status }>{ tr(ctx, "responses.status." + status) }</option>
							}
						</select>
					</label>
					<button type="submit" class="secondary">{ tr(ctx, "common.save") }</button>
				</form>
			</section>
			<section class="panel response-workflow">
				<div>
					<h2>{ tr(ctx, "responses.assignee") }</h2>
					if data.CanEdit {
						<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/bulk") } class="response-status-form">
							<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
							<input type="hidden" name="ids" value={ submission.PublicID }/>
							<input type="hidden" name="back" value={ submission.PublicID }/>
							<label>
								<span class="visually-hidden">{ tr(ctx, "responses.assignee") }</span>
								<select name="action">
									<option value="unassign" selected?={ !submission.AssigneeUserID.Valid }>{ tr(ctx, "responses.assignee.none") }</option>
									for _, member := range data.Members {
										<option value={ "assign:" + member.PublicID } selected?={ submission.AssigneeUserID.Valid && member.Name == submission.AssigneeName }>{ member.Name }</option>
									}
								</select>
							</label>
							<button type="submit" class="secondary">{ tr(ctx, "common.save") }</button>
						</form>
					} else if submission.AssigneeName != "" {
						<p><span class="badge assignee">→ { submission.AssigneeName }</span></p>
					} else {
						<p class="muted">{ tr(ctx, "responses.assignee.none") }</p>
					}
				</div>
				<div>
					<h2>{ tr(ctx, "responses.tag") }</h2>
					<ul class="tag-list">
						for _, tag := range submission.Tags {
							<li class="view-item">
								<span class="badge tag">#{ tag }</span>
								if data.CanEdit {
									<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/bulk") } class="inline-form">
										<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
										<input type="hidden" name="ids" value={ submission.PublicID }/>
										<input type="hidden" name="back" value={ submission.PublicID }/>
										<input type="hidden" name="action" value="tag_remove"/>
										<input type="hidden" name="tag" value={ tag }/>
										<button type="submit" class="link-button" aria-label={ tr(ctx, "responses.tag.remove", tag) } title={ tr(ctx, "responses.tag.remove", tag) }>×</button>
									</form>
								}
							</li>
						}
						if len(submission.Tags) == 0 {
							<li class="muted">{ tr(ctx, "responses.tag.none") }</li>
						}
					</ul>
					if data.CanEdit {
						<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/bulk") } class="response-status-form">
							<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
							<input type="hidden" name="ids" value={ submission.PublicID }/>
							<input type="hidden" name="back" value={ submission.PublicID }/>
							<input type="hidden" name="action" value="tag_add"/>
							<label>
								<span class="visually-hidden">{ tr(ctx, "responses.bulk.tag_placeholder") }</span>
								<input type="text" name="tag" list="response-tag-options" maxlength="30" placeholder={ tr(ctx, "responses.bulk.tag_placeholder") } required/>
							</label>
							@tagDatalist(data.Tags)
							<button type="submit" class="secondary">{ tr(ctx, "responses.tag.add") }</button>
						</form>
					}
				</div>
			</section>
			<section class="panel response-readers">
				<h2>{ tr(ctx, "responses.readers") }</h2>
				<ul class="reader-list">
					for _, reader := range data.Readers {
						<li>
							<strong>{ reader.Name }</strong>
							if reader.IsMe {
								<span class="badge read-mine">{ tr(ctx, "responses.readers.you") }</span>
							}
							<time class="muted" data-local-time datetime={ reader.FirstReadAt }>{ reader.FirstReadAt }</time>
						</li>
					}
				</ul>
				<div class="actions compact">
					@responseSingleAction(campaign, submission, "unread", "responses.mark_unread")
					if data.CanEdit {
						if submission.Starred {
							@responseSingleAction(campaign, submission, "unstar", "responses.star.remove")
						} else {
							@responseSingleAction(campaign, submission, "star", "responses.star.add")
						}
					}
				</div>
			</section>
			if len(submission.URLContext) > 0 {
				<section class="panel response-context">
					<h2>{ tr(ctx, "responses.context") }</h2>
					<dl class="stats">
						for _, key := range sortedContextKeys(submission.URLContext) {
							<dt>{ key }</dt>
							<dd>{ submission.URLContext[key] }</dd>
						}
					</dl>
				</section>
			}
			for _, answer := range submission.Answers {
				<article class="panel response-answer">
					<div class="field-heading">
						<div><span class="badge quiet">{ tr(ctx, "form.type." + answer.FieldType) }</span><h2>{ answer.FieldLabelSnapshot }</h2></div>
						<button class="button secondary copy-button" type="button" data-copy-target={ "answer-" + answer.FieldPublicID } data-copy-label={ tr(ctx, "copy.copied") } data-tooltip={ tr(ctx, "tooltip.btn.copy") }>{ tr(ctx, "copy.action") }</button>
					</div>
					<p id={ "answer-" + answer.FieldPublicID }>{ submissionAnswerDisplay(answerDisplayValueJSON(answer)) }</p>
				</article>
			}
			<section class="panel response-notes" id="notes">
				<h2>{ tr(ctx, "responses.notes.title") }</h2>
				<p class="muted">{ tr(ctx, "responses.notes.help") }</p>
				for _, note := range data.Notes {
					<article class="note">
						<header>
							<strong>{ noteAuthor(ctx, note) }</strong>
							<time class="muted" data-local-time datetime={ note.CreatedAt }>{ note.CreatedAt }</time>
							if data.CanEdit || (note.AuthorUserID.Valid && note.AuthorUserID.Int64 == data.CurrentUserID) {
								<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/" + submission.PublicID + "/notes/" + note.PublicID + "/delete") } class="inline-form">
									<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
									<button type="submit" class="link-button">{ tr(ctx, "responses.notes.delete") }</button>
								</form>
							}
						</header>
						<p>{ note.Body }</p>
					</article>
				}
				<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/" + submission.PublicID + "/notes") } class="note-form">
					<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
					<label>
						<span class="visually-hidden">{ tr(ctx, "responses.notes.add") }</span>
						<textarea name="body" rows="3" maxlength="2000" required placeholder={ tr(ctx, "responses.notes.placeholder") }></textarea>
					</label>
					<button type="submit" class="secondary">{ tr(ctx, "responses.notes.add") }</button>
				</form>
			</section>
		</div>
	}
}

templ tagDatalist(tags []db.ResponseTag) {
	<datalist id="response-tag-options">
		for _, tag := range tags {
			<option value={ tag.Name }></option>
		}
	</datalist>
}

templ shortcutHelp(kind string) {
	<div class="notice shortcut-help" id="shortcut-help" hidden>
		<strong>{ tr(ctx, "responses.shortcuts.title") }</strong>
		<ul>
			if kind == "list" {
				<li><kbd>j</kbd> / <kbd>k</kbd> — { tr(ctx, "responses.shortcuts.list.move") }</li>
				<li><kbd>Enter</kbd> — { tr(ctx, "responses.shortcuts.list.open") }</li>
				<li><kbd>x</kbd> — { tr(ctx, "responses.shortcuts.list.select") }</li>
				<li><kbd>/</kbd> — { tr(ctx, "responses.shortcuts.list.search") }</li>
			} else {
				<li><kbd>j</kbd> / <kbd>k</kbd> — { tr(ctx, "responses.shortcuts.detail.older_newer") }</li>
				<li><kbd>n</kbd> — { tr(ctx, "responses.shortcuts.detail.next_unread") }</li>
				<li><kbd>r</kbd> — { tr(ctx, "responses.shortcuts.detail.unread") }</li>
				<li><kbd>s</kbd> — { tr(ctx, "responses.shortcuts.detail.star") }</li>
				<li><kbd>u</kbd> — { tr(ctx, "responses.shortcuts.detail.back") }</li>
			}
			<li><kbd>?</kbd> — { tr(ctx, "responses.shortcuts.toggle") }</li>
		</ul>
	</div>
}

templ responseSingleAction(campaign db.Campaign, submission db.Submission, action, labelKey string) {
	<form method="post" action={ templ.SafeURL(campaignPath(campaign) + "/responses/bulk") } data-shortcut-action={ action }>
		<input type="hidden" name="csrf_token" value={ csrfFromContext(ctx) }/>
		<input type="hidden" name="ids" value={ submission.PublicID }/>
		<input type="hidden" name="back" value={ submission.PublicID }/>
		<input type="hidden" name="action" value={ action }/>
		<button type="submit" class="secondary">{ tr(ctx, labelKey) }</button>
	</form>
}

func answerDisplayValueJSON(answer db.SubmissionAnswer) string {
	if answer.DisplayValueJSON != "" {
		return answer.DisplayValueJSON
	}
	return answer.ValueJSON
}

func submissionAnswerDisplay(raw string) string {
	var value any
	if json.Unmarshal([]byte(raw), &value) != nil {
		return ""
	}
	switch typed := value.(type) {
	case []any:
		values := make([]string, 0, len(typed))
		for _, item := range typed {
			values = append(values, fmt.Sprint(item))
		}
		return strings.Join(values, ", ")
	default:
		return fmt.Sprint(value)
	}
}

func responseIssueURL(settings db.CampaignSettings, campaign db.Campaign, submission db.Submission) string {
	if !settings.DevFeedbackIssueURL.Valid || settings.DevFeedbackIssueURL.String == "" {
		return ""
	}
	parsed, err := url.Parse(settings.DevFeedbackIssueURL.String)
	if err != nil {
		return settings.DevFeedbackIssueURL.String
	}
	values := parsed.Query()
	if values.Get("title") == "" {
		values.Set("title", campaign.Name+": feedback "+submission.PublicID)
	}
	if values.Get("body") == "" {
		values.Set("body", responseIssueBody(campaign, submission))
	}
	parsed.RawQuery = values.Encode()
	return parsed.String()
}

func responseIssueBody(campaign db.Campaign, submission db.Submission) string {
	var body strings.Builder
	body.WriteString("Campaign: ")
	body.WriteString(campaign.Name)
	body.WriteString("\nSubmission: ")
	body.WriteString(submission.PublicID)
	body.WriteString("\nSubmitted at: ")
	body.WriteString(submission.SubmittedAt)
	body.WriteString("\nStatus: ")
	body.WriteString(submission.TriageStatus)
	body.WriteString("\n\nFeedback:\n")
	for _, answer := range submission.Answers {
		body.WriteString("\n")
		body.WriteString(answer.FieldLabelSnapshot)
		body.WriteString("\n")
		body.WriteString(submissionAnswerDisplay(answerDisplayValueJSON(answer)))
		body.WriteString("\n")
	}
	if len(submission.URLContext) > 0 {
		body.WriteString("\nContext:\n")
		for _, key := range sortedContextKeys(submission.URLContext) {
			body.WriteString(key)
			body.WriteString(": ")
			body.WriteString(submission.URLContext[key])
			body.WriteString("\n")
		}
	}
	return body.String()
}

func sortedContextKeys(values map[string]string) []string {
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

func helpID(field db.FormField) string {
	return "help_" + field.PublicID
}

func fieldAttrs(field db.FormField) templ.Attributes {
	if field.HelpText.Valid {
		return templ.Attributes{"aria-describedby": helpID(field)}
	}
	return nil
}

func responsesPageURL(campaign db.Campaign, filter db.ResponseFilter, page int) string {
	filter.Page = page
	target := campaignPath(campaign) + "/responses"
	if encoded := filter.Values().Encode(); encoded != "" {
		target += "?" + encoded
	}
	return target
}

func responseChipAttrs(current, target db.ResponseFilter) templ.Attributes {
	current.Page, target.Page = 1, 1
	if current.Values().Encode() == target.Values().Encode() {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

func responseFilterFields(filter db.ResponseFilter) [][2]string {
	values := filter.Values()
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	fields := make([][2]string, 0, len(keys))
	for _, key := range keys {
		fields = append(fields, [2]string{key, values.Get(key)})
	}
	return fields
}

func truncateRunes(value string, limit int) string {
	if runes := []rune(value); len(runes) > limit {
		return string(runes[:limit]) + "..."
	}
	return value
}

// submissionTextPreview returns the first non-empty free-text answer.
func submissionTextPreview(submission db.Submission) string {
	for _, answer := range submission.Answers {
		if answer.FieldType != "textarea" {
			continue
		}
		if value := strings.TrimSpace(submissionAnswerDisplay(answer.ValueJSON)); value != "" {
			return truncateRunes(value, 200)
		}
	}
	return ""
}

// submissionChoicePreview summarises radio, checkbox and rating answers.
func submissionChoicePreview(submission db.Submission) string {
	var parts []string
	for _, answer := range submission.Answers {
		if answer.FieldType == "textarea" {
			continue
		}
		if value := strings.TrimSpace(submissionAnswerDisplay(answerDisplayValueJSON(answer))); value != "" {
			parts = append(parts, value)
		}
	}
	return truncateRunes(strings.Join(parts, " · "), 140)
}

func responsesExportURL(campaign db.Campaign, filter db.ResponseFilter, format string) string {
	filter.Page = 1
	target := campaignPath(campaign) + "/export/submissions." + format
	if encoded := filter.Values().Encode(); encoded != "" {
		target += "?" + encoded
	}
	return target
}

func responseNeighborURL(campaign db.Campaign, publicID string) string {
	if publicID == "" {
		return ""
	}
	return campaignPath(campaign) + "/responses/" + publicID
}

func noteAuthor(ctx context.Context, note db.SubmissionNote) string {
	if note.AuthorName == "" {
		return tr(ctx, "responses.notes.unknown_author")
	}
	return note.AuthorName
}
